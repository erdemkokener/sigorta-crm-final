<div class="row mb-4">
  <div class="col-md-8">
    <h1 class="h3"><i class="bi bi-person-badge"></i> Satışçı Detayı: <%= salesperson.name %></h1>
  </div>
  <div class="col-md-4 text-end">
    <div class="btn-group me-2">
      <button type="button" class="btn btn-success dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
        <i class="bi bi-file-earmark-excel"></i> Excel
      </button>
      <ul class="dropdown-menu">
        <li><a class="dropdown-item" href="/salespersons/<%= salesperson.id %>/export/customers">Müşteri Listesi</a></li>
        <li><a class="dropdown-item" href="/salespersons/<%= salesperson.id %>/export/policies">Poliçe Listesi</a></li>
      </ul>
    </div>
    <a href="/salespersons/<%= salesperson.id %>/edit" class="btn btn-warning"><i class="bi bi-pencil"></i> Düzenle</a>
    <a href="/salespersons" class="btn btn-secondary"><i class="bi bi-arrow-left"></i> Listeye Dön</a>
  </div>
</div>

<div class="row mb-4">
  <div class="col-md-6 mb-3">
    <div class="card shadow-sm h-100">
      <div class="card-body">
        <h5 class="card-title text-muted">İletişim Bilgileri</h5>
        <p class="mb-1"><strong>Telefon:</strong> <%= salesperson.phone || '-' %></p>
        <p class="mb-1"><strong>E-posta:</strong> <%= salesperson.email || '-' %></p>
        <p class="mb-0"><strong>Not:</strong> <%= salesperson.note || '-' %></p>
      </div>
    </div>
  </div>
  <div class="col-md-3 mb-3">
    <div class="card bg-primary text-white h-100">
      <div class="card-body text-center d-flex flex-column justify-content-center">
        <h3 class="display-4 fw-bold"><%= customers.length %></h3>
        <p class="mb-0">Müşteri Sayısı</p>
      </div>
    </div>
  </div>
  <div class="col-md-3 mb-3">
    <div class="card bg-success text-white h-100">
      <div class="card-body text-center d-flex flex-column justify-content-center">
        <h3 class="display-4 fw-bold"><%= policies.length %></h3>
        <p class="mb-0">Toplam Poliçe</p>
      </div>
    </div>
  </div>
</div>

<div class="row mb-4">
  <div class="col-md-3">
    <div class="card bg-info text-white h-100">
      <div class="card-body text-center">
        <h5 class="card-title">Toplam Hak Ediş</h5>
        <h3 class="fw-bold"><%= (typeof stats !== 'undefined' ? stats.totalCommission : 0).toFixed(2) %> TL</h3>
      </div>
    </div>
  </div>
  <div class="col-md-3">
    <div class="card bg-warning text-dark h-100">
      <div class="card-body text-center">
        <h5 class="card-title">Toplam Ödenen</h5>
        <h3 class="fw-bold"><%= (typeof stats !== 'undefined' ? stats.totalPaid : 0).toFixed(2) %> TL</h3>
      </div>
    </div>
  </div>
  <div class="col-md-3">
    <div class="card <%= (typeof stats !== 'undefined' && stats.balance > 0) ? 'bg-danger' : 'bg-success' %> text-white h-100">
      <div class="card-body text-center">
        <h5 class="card-title">Komisyon Bakiyesi</h5>
        <h3 class="fw-bold"><%= (typeof stats !== 'undefined' ? stats.balance : 0).toFixed(2) %> TL</h3>
        <small><%= (typeof stats !== 'undefined' && stats.balance > 0) ? 'Ödeme Yapılmalı' : 'Borcu Yok / Alacaklı' %></small>
      </div>
    </div>
  </div>
  <div class="col-md-3">
    <div class="card bg-dark text-white h-100">
      <div class="card-body text-center">
        <h5 class="card-title">Tahsil Edilecek Prim</h5>
        <h3 class="fw-bold"><%= (typeof stats !== 'undefined' ? stats.totalDebt : 0).toFixed(2) %> TL</h3>
        <small>Müşterilerden Alınacak</small>
      </div>
    </div>
  </div>
</div>

<ul class="nav nav-tabs mb-3" id="salespersonTabs" role="tablist">
  <li class="nav-item" role="presentation">
    <button class="nav-link active" id="customers-tab" data-bs-toggle="tab" data-bs-target="#customers" type="button" role="tab">Müşteriler (<%= customers.length %>)</button>
  </li>
  <li class="nav-item" role="presentation">
    <button class="nav-link" id="policies-tab" data-bs-toggle="tab" data-bs-target="#policies" type="button" role="tab">Poliçeler (<%= policies.length %>)</button>
  </li>
  <li class="nav-item" role="presentation">
    <button class="nav-link" id="debt-policies-tab" data-bs-toggle="tab" data-bs-target="#debt-policies" type="button" role="tab">
      <i class="bi bi-exclamation-circle"></i> Tahsilat Bekleyenler
      <% const debtPolicies = policies.filter(p => p.premium_remaining > 0); %>
      <% if (debtPolicies.length > 0) { %>
        <span class="badge bg-danger ms-1"><%= debtPolicies.length %></span>
      <% } %>
    </button>
  </li>
  <li class="nav-item" role="presentation">
    <button class="nav-link" id="payments-tab" data-bs-toggle="tab" data-bs-target="#payments" type="button" role="tab">Ödemeler & Hesap</button>
  </li>
</ul>

<div class="tab-content" id="salespersonTabsContent">
  <!-- Müşteriler Sekmesi -->
  <div class="tab-pane fade show active" id="customers" role="tabpanel">
    <div class="card shadow-sm">
      <div class="card-body">
        <% if (customers.length === 0) { %>
          <div class="alert alert-light">Bu satışçıya ait müşteri bulunamadı.</div>
        <% } else { %>
          <div class="table-responsive">
            <table class="table table-hover">
              <thead>
                <tr>
                  <th>Ad Soyad</th>
                  <th>Telefon</th>
                  <th>Meslek</th>
                  <th>İşlemler</th>
                </tr>
              </thead>
              <tbody>
                <% customers.forEach(c => { %>
                  <tr>
                    <td><%= c.name %></td>
                    <td><%= c.phone %></td>
                    <td><%= c.profession %></td>
                    <td>
                      <a href="/customers/<%= c.id %>" class="btn btn-sm btn-info">Detay</a>
                    </td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        <% } %>
      </div>
    </div>
  </div>

  <!-- Poliçeler Sekmesi -->
  <div class="tab-pane fade" id="policies" role="tabpanel">
    <div class="card shadow-sm">
      <div class="card-body">
        <% if (policies.length === 0) { %>
          <div class="alert alert-light">Bu satışçıya ait poliçe bulunamadı.</div>
        <% } else { %>
          <div class="table-responsive">
            <table class="table table-hover">
              <thead>
                <tr>
                  <th>Poliçe No</th>
                  <th>Müşteri</th>
                  <th>Şirket</th>
                  <th>Tür</th>
                  <th>Bitiş Tarihi</th>
                  <th>Komisyon (Hakediş)</th>
                  <th>İşlemler</th>
                </tr>
              </thead>
              <tbody>
                <% policies.forEach(p => { %>
                  <tr>
                    <td><%= p.policy_number %></td>
                    <td>
                        <a href="/customers/<%= p.customer_id %>" class="text-decoration-none"><%= p.customer_name %></a>
                    </td>
                    <td><%= p.insurer %></td>
                    <td><span class="badge bg-info text-dark"><%= p.policy_type %></span></td>
                    <td><%= p.end_date %></td>
                    <td><%= p.salesperson_commission ? p.salesperson_commission.toFixed(2) : '0.00' %> TL</td>
                    <td>
                      <a href="/policies/<%= p.id %>" class="btn btn-sm btn-info">Detay</a>
                    </td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        <% } %>
      </div>
    </div>
  </div>

  <!-- Tahsilat Bekleyenler Sekmesi -->
  <div class="tab-pane fade" id="debt-policies" role="tabpanel">
    <div class="card shadow-sm border-danger">
      <div class="card-header bg-danger text-white">
        <h5 class="mb-0"><i class="bi bi-wallet2"></i> Tahsil Edilecek Primler</h5>
      </div>
      <div class="card-body">
        <% if (debtPolicies.length === 0) { %>
          <div class="alert alert-success mb-0">
            <i class="bi bi-check-circle-fill"></i> Harika! Bu satışçıya ait tahsil edilmemiş poliçe primi bulunmuyor.
          </div>
        <% } else { %>
          <div class="table-responsive">
            <table class="table table-hover align-middle">
              <thead class="table-light">
                <tr>
                  <th>Müşteri</th>
                  <th>Poliçe No</th>
                  <th>Vade Sonu</th>
                  <th class="text-end">Toplam Prim</th>
                  <th class="text-end">Ödenen</th>
                  <th class="text-end text-danger fw-bold">Kalan (Borç)</th>
                  <th class="text-end">İşlem</th>
                </tr>
              </thead>
              <tbody>
                <% debtPolicies.forEach(p => { %>
                  <tr>
                    <td>
                      <a href="/customers/<%= p.customer_id %>" class="fw-bold text-dark text-decoration-none">
                        <%= p.customer_name %>
                      </a>
                      <div class="small text-muted"><%= p.customer_phone || '-' %></div>
                    </td>
                    <td>
                        <a href="/policies/<%= p.id %>" class="text-decoration-none"><%= p.policy_number %></a>
                        <div class="small text-muted"><%= p.insurer %> - <%= p.policy_type %></div>
                    </td>
                    <td>
                        <%= p.end_date %>
                        <% if (p.is_expired) { %>
                            <span class="badge bg-danger ms-1">Süresi Doldu</span>
                        <% } else if (p.is_expiring_soon) { %>
                            <span class="badge bg-warning text-dark ms-1">Yaklaşıyor</span>
                        <% } %>
                    </td>
                    <td class="text-end"><%= p.premium_total.toFixed(2) %> TL</td>
                    <td class="text-end"><%= p.premium_paid.toFixed(2) %> TL</td>
                    <td class="text-end text-danger fw-bold"><%= p.premium_remaining.toFixed(2) %> TL</td>
                    <td class="text-end">
                      <a href="/customers/<%= p.customer_id %>/invoice?policy_id=<%= p.id %>" class="btn btn-sm btn-outline-success">
                        <i class="bi bi-cash"></i> Tahsil Et
                      </a>
                    </td>
                  </tr>
                <% }); %>
                <tr class="table-danger fw-bold">
                    <td colspan="5" class="text-end">TOPLAM ALACAK:</td>
                    <td class="text-end"><%= (typeof stats !== 'undefined' ? stats.totalDebt : 0).toFixed(2) %> TL</td>
                    <td></td>
                </tr>
              </tbody>
            </table>
          </div>
        <% } %>
      </div>
    </div>
  </div>

  <!-- Ödemeler Sekmesi -->
  <div class="tab-pane fade" id="payments" role="tabpanel">
    <div class="row">
      <div class="col-md-8">
         <div class="card shadow-sm mb-4">
           <div class="card-header">Satışçıya Yapılan Ödemeler</div>
           <div class="card-body">
             <% if (typeof payments === 'undefined' || payments.length === 0) { %>
               <p class="text-muted">Henüz satışçıya ödeme yapılmamış.</p>
             <% } else { %>
               <div class="table-responsive">
               <table class="table table-sm table-striped">
                 <thead><tr><th>Tarih</th><th>Tutar</th><th>Açıklama</th></tr></thead>
                 <tbody>
                   <% payments.forEach(p => { %>
                     <tr>
                       <td><%= p.payment_date %></td>
                       <td><%= p.amount.toFixed(2) %> TL</td>
                       <td><%= p.description %></td>
                     </tr>
                   <% }); %>
                 </tbody>
               </table>
               </div>
             <% } %>
           </div>
         </div>
      </div>
      <div class="col-md-4">
        <div class="card shadow-sm">
          <div class="card-header bg-light">Satışçıya Ödeme Yap</div>
          <div class="card-body">
            <div class="alert alert-info small py-2">
              <i class="bi bi-info-circle"></i> Buradan girilen ödemeler, satışçının <strong>Komisyon Bakiyesinden</strong> düşülür.
            </div>
            <form action="/salespersons/<%= salesperson.id %>/payments" method="POST">
              <div class="mb-3">
                <label class="form-label">Tarih</label>
                <input type="date" class="form-control" name="payment_date" required value="<%= new Date().toISOString().split('T')[0] %>">
              </div>
              <div class="mb-3">
                <label class="form-label">Tutar</label>
                <input type="number" step="0.01" class="form-control" name="amount" required>
              </div>
              <div class="mb-3">
                <label class="form-label">Açıklama</label>
                <textarea class="form-control" name="description" rows="2" placeholder="Örn: Komisyon ödemesi"></textarea>
              </div>
              <button type="submit" class="btn btn-primary w-100">Ödemeyi Kaydet</button>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
