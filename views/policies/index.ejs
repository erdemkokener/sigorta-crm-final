<div class="mb-4">
  <div class="row">
    <div class="col-md-8">
      <h2>Poliçeler</h2>
    </div>
    <div class="col-md-4 text-end">
      <a href="/policies/new" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> Yeni Poliçe
      </a>
    </div>
  </div>
</div>

<div class="card mb-4">
  <div class="card-body">
    <form method="get" action="/policies" class="row g-3">
      <div class="col-md-3">
        <input type="text" class="form-control" name="q" placeholder="Ara..." value="<%= query.q || '' %>">
      </div>
      <div class="col-md-2">
        <select class="form-select" name="branch">
          <option value="">Tüm Şubeler</option>
          <option value="Akhisar" <%= query.branch === 'Akhisar' ? 'selected' : '' %>>Akhisar</option>
          <option value="Balıkesir" <%= query.branch === 'Balıkesir' ? 'selected' : '' %>>Balıkesir</option>
          <option value="Ada Şube" <%= query.branch === 'Ada Şube' ? 'selected' : '' %>>Ada Şube</option>
          <option value="İlke Şube" <%= query.branch === 'İlke Şube' ? 'selected' : '' %>>İlke Şube</option>
        </select>
      </div>
      <div class="col-md-2">
        <select class="form-select" name="insurer">
          <option value="">Tüm Sigortalar</option>
          <option value="Anadolu Sigorta" <%= query.insurer === 'Anadolu Sigorta' ? 'selected' : '' %>>Anadolu Sigorta</option>
          <option value="Allianz" <%= query.insurer === 'Allianz' ? 'selected' : '' %>>Allianz</option>
          <option value="Eureko" <%= query.insurer === 'Eureko' ? 'selected' : '' %>>Eureko</option>
          <option value="Halk Sigorta" <%= query.insurer === 'Halk Sigorta' ? 'selected' : '' %>>Halk Sigorta</option>
          <option value="Mapfre" <%= query.insurer === 'Mapfre' ? 'selected' : '' %>>Mapfre</option>
          <option value="Sigortam.net" <%= query.insurer === 'Sigortam.net' ? 'selected' : '' %>>Sigortam.net</option>
          <option value="Turkiye Sigorta" <%= query.insurer === 'Turkiye Sigorta' ? 'selected' : '' %>>Türkiye Sigorta</option>
          <option value="Win Sigorta" <%= query.insurer === 'Win Sigorta' ? 'selected' : '' %>>Win Sigorta</option>
          <option value="ETG Sigorta" <%= query.insurer === 'ETG Sigorta' ? 'selected' : '' %>>ETG Sigorta</option>
        </select>
      </div>
      <div class="col-md-2">
        <select class="form-select" name="filter">
          <option value="">Tüm Tarihler</option>
          <option value="today" <%= query.filter === 'today' ? 'selected' : '' %>>Bugün</option>
          <option value="tomorrow" <%= query.filter === 'tomorrow' ? 'selected' : '' %>>Yarın</option>
          <option value="week" <%= query.filter === 'week' ? 'selected' : '' %>>Bu Hafta</option>
        </select>
      </div>
      <div class="col-md-3 d-flex gap-2">
        <button type="submit" class="btn btn-primary flex-grow-1">Filtrele</button>
        <a href="/policies" class="btn btn-outline-secondary">Sıfırla</a>
      </div>
    </form>
  </div>
</div>

<div class="card">
  <div class="card-body">
    <div class="table-responsive">
      <table class="table table-hover">
        <thead>
          <tr>
            <th>#</th>
            <th>Müşteri</th>
            <th>Şube</th>
            <th>Sigorta</th>
            <th>Tür</th>
            <th>Poliçe No</th>
            <th>Başlangıç</th>
            <th>Bitiş</th>
            <th>Prim</th>
            <th>Kalan</th>
            <th>Durum</th>
            <th>İşlemler</th>
          </tr>
        </thead>
        <tbody>
          <% if (policies.length === 0) { %>
            <tr>
              <td colspan="12" class="text-center text-muted py-4">Poliçe bulunamadı</td>
            </tr>
          <% } %>
          <% policies.forEach(policy => { %>
            <tr class="<%= policy.is_missed_renewal ? 'table-warning' : '' %>">
              <td><%= policy.id %></td>
              <td>
                <%= policy.customer_name %>
                <small class="text-muted d-block"><%= policy.customer_phone %></small>
              </td>
              <td><span class="badge bg-secondary"><%= policy.branch %></span></td>
              <td><%= policy.insurer %></td>
              <td><%= policy.policy_type %></td>
              <td><%= policy.policy_number || '-' %></td>
              <td><%= formatDate(policy.start_date) %></td>
              <td><%= formatDate(policy.end_date) %></td>
              <td><%= policy.premium ? policy.premium.toLocaleString('tr-TR') + ' TL' : '-' %></td>
              <td><%= policy.premium_remaining > 0 ? policy.premium_remaining.toLocaleString('tr-TR') + ' TL' : '-' %></td>
              <td>
                <% if (policy.is_missed_renewal) { %>
                  <span class="badge bg-warning text-dark">Yenileme Günü</span>
                <% } else if (policy.is_expired) { %>
                  <span class="badge bg-danger">Süresi Dolmuş</span>
                <% } else if (policy.is_expiring_soon) { %>
                  <span class="badge bg-warning text-dark">Yakında Doluyor</span>
                <% } else { %>
                  <span class="badge bg-success">Aktif</span>
                <% } %>
              </td>
              <td>
                <div class="d-flex gap-1">
                  <a href="/policies/<%= policy.id %>" class="btn btn-sm btn-outline-info">Görüntüle</a>
                  <a href="/policies/<%= policy.id %>/edit" class="btn btn-sm btn-outline-primary">Düzenle</a>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>
