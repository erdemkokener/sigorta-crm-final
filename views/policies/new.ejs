<div class="card mb-4">
  <div class="card-header">
    <% if (policy) { %>
      Poliçe Düzenle
    <% } else { %>
      Yeni Poliçe
    <% } %>
  </div>
  <div class="card-body">
    <form method="post" action="<%= policy ? `/policies/${policy.id}/edit` : `/policies/new` %>">
      <div class="row mb-3">
        <div class="col-md-6">
          <label for="customer_id" class="form-label">Müşteri *</label>
          <select class="form-select" id="customer_id" name="customer_id" required>
            <option value="">Seçiniz...</option>
            <% customers.forEach(customer => { %>
              <option value="<%= customer.id %>" <%= policy && policy.customer_id == customer.id ? 'selected' : '' %>>
                <%= customer.name %> <%= customer.phone ? `(${customer.phone})` : '' %>
              </option>
            <% }) %>
          </select>
        </div>
        <div class="col-md-6">
          <label for="branch" class="form-label">Şube *</label>
          <select class="form-select" id="branch" name="branch" required>
            <option value="Akhisar" <%= policy && policy.branch === 'Akhisar' ? 'selected' : '' %>>Akhisar</option>
            <option value="Balıkesir" <%= policy && policy.branch === 'Balıkesir' ? 'selected' : '' %>>Balıkesir</option>
            <option value="Ada Şube" <%= policy && policy.branch === 'Ada Şube' ? 'selected' : '' %>>Ada Şube</option>
            <option value="İlke Şube" <%= policy && policy.branch === 'İlke Şube' ? 'selected' : '' %>>İlke Şube</option>
          </select>
        </div>
      </div>
      
      <div class="row mb-3">
        <div class="col-md-4">
          <label for="insurer" class="form-label">Sigorta Şirketi *</label>
          <select class="form-select" id="insurer" name="insurer" required>
            <option value="">Seçiniz...</option>
            <option value="Anadolu Sigorta" <%= policy && policy.insurer === 'Anadolu Sigorta' ? 'selected' : '' %>>Anadolu Sigorta</option>
            <option value="Allianz" <%= policy && policy.insurer === 'Allianz' ? 'selected' : '' %>>Allianz</option>
            <option value="Eureko" <%= policy && policy.insurer === 'Eureko' ? 'selected' : '' %>>Eureko</option>
            <option value="Halk Sigorta" <%= policy && policy.insurer === 'Halk Sigorta' ? 'selected' : '' %>>Halk Sigorta</option>
            <option value="Mapfre" <%= policy && policy.insurer === 'Mapfre' ? 'selected' : '' %>>Mapfre</option>
            <option value="Sigortam.net" <%= policy && policy.insurer === 'Sigortam.net' ? 'selected' : '' %>>Sigortam.net</option>
            <option value="Turkiye Sigorta" <%= policy && policy.insurer === 'Turkiye Sigorta' ? 'selected' : '' %>>Türkiye Sigorta</option>
            <option value="Win Sigorta" <%= policy && policy.insurer === 'Win Sigorta' ? 'selected' : '' %>>Win Sigorta</option>
            <option value="ETG Sigorta" <%= policy && policy.insurer === 'ETG Sigorta' ? 'selected' : '' %>>ETG Sigorta</option>
          </select>
        </div>
        <div class="col-md-4">
          <label for="policy_type" class="form-label">Poliçe Türü *</label>
          <select class="form-select" id="policy_type" name="policy_type" required>
            <option value="">Seçiniz...</option>
            <option value="Kasko" <%= policy && policy.policy_type === 'Kasko' ? 'selected' : '' %>>Kasko</option>
            <option value="Trafik" <%= policy && policy.policy_type === 'Trafik' ? 'selected' : '' %>>Trafik</option>
            <option value="DASK" <%= policy && policy.policy_type === 'DASK' ? 'selected' : '' %>>DASK</option>
            <option value="Konut" <%= policy && policy.policy_type === 'Konut' ? 'selected' : '' %>>Konut</option>
            <option value="Sağlık" <%= policy && policy.policy_type === 'Sağlık' ? 'selected' : '' %>>Sağlık</option>
            <option value="Seyahat" <%= policy && policy.policy_type === 'Seyahat' ? 'selected' : '' %>>Seyahat</option>
          </select>
        </div>
        <div class="col-md-4">
          <label for="policy_number" class="form-label">Poliçe Numarası</label>
          <input type="text" class="form-control" id="policy_number" name="policy_number" value="<%= policy ? policy.policy_number : '' %>">
        </div>
      </div>

      <div class="row mb-3">
        <div class="col-md-4">
          <label for="issue_date" class="form-label">Düzenleme Tarihi</label>
          <input type="date" class="form-control" id="issue_date" name="issue_date" value="<%= policy ? policy.issue_date : '' %>">
        </div>
        <div class="col-md-4">
          <label for="start_date" class="form-label">Başlangıç Tarihi *</label>
          <input type="date" class="form-control" id="start_date" name="start_date" value="<%= policy ? policy.start_date : '' %>" required>
        </div>
        <div class="col-md-4">
          <label for="end_date" class="form-label">Bitiş Tarihi *</label>
          <input type="date" class="form-control" id="end_date" name="end_date" value="<%= policy ? policy.end_date : '' %>" required>
        </div>
      </div>

      <div class="row mb-3">
        <div class="col-md-6">
          <label for="premium" class="form-label">Prim (TL)</label>
          <input type="number" step="0.01" class="form-control" id="premium" name="premium" value="<%= policy ? policy.premium : '' %>">
        </div>
        <div class="col-md-6">
          <label for="premium_paid" class="form-label">Ödenen Prim (TL)</label>
          <input type="number" step="0.01" class="form-control" id="premium_paid" name="premium_paid" value="<%= policy ? policy.premium_paid : '' %>">
        </div>
      </div>

      <div class="mb-3">
        <label for="description" class="form-label">Açıklama</label>
        <textarea class="form-control" id="description" name="description" rows="3"><%= policy ? policy.description : '' %></textarea>
      </div>

      <div class="card mb-3">
        <div class="card-header">
          <button class="btn btn-outline-secondary btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#policyDetails">
            Poliçe Detayları
          </button>
        </div>
        <div id="policyDetails" class="collapse">
          <div class="card-body">
            <h6 class="card-subtitle mb-3 text-muted">Araç Bilgileri</h6>
            <div class="row mb-2">
              <div class="col-md-4">
                <label for="plate" class="form-label">Plaka</label>
                <input type="text" class="form-control" id="plate" name="plate" value="<%= policy && policy.policy_details ? policy.policy_details.plate : '' %>">
              </div>
              <div class="col-md-4">
                <label for="registration_no" class="form-label">Tescil No</label>
                <input type="text" class="form-control" id="registration_no" name="registration_no" value="<%= policy && policy.policy_details ? policy.policy_details.registration_no : '' %>">
              </div>
              <div class="col-md-4">
                <label for="vehicle_type" class="form-label">Araç Türü</label>
                <input type="text" class="form-control" id="vehicle_type" name="vehicle_type" value="<%= policy && policy.policy_details ? policy.policy_details.vehicle_type : '' %>">
              </div>
            </div>
            
            <div class="row mb-2">
              <div class="col-md-4">
                <label for="visa_date" class="form-label">Vize Tarihi</label>
                <input type="date" class="form-control" id="visa_date" name="visa_date" value="<%= policy && policy.policy_details ? policy.policy_details.visa_date : '' %>">
              </div>
              <div class="col-md-4">
                <label for="sale_date" class="form-label">Satış Tarihi</label>
                <input type="date" class="form-control" id="sale_date" name="sale_date" value="<%= policy && policy.policy_details ? policy.policy_details.sale_date : '' %>">
              </div>
              <div class="col-md-4">
                <label for="profession" class="form-label">Meslek</label>
                <input type="text" class="form-control" id="profession" name="profession" value="<%= policy && policy.policy_details ? policy.policy_details.profession : '' %>">
              </div>
            </div>

            <h6 class="card-subtitle mb-3 text-muted mt-4">Konut Bilgileri</h6>
            <div class="row mb-2">
              <div class="col-md-4">
                <label for="notary_name" class="form-label">Noter</label>
                <input type="text" class="form-control" id="notary_name" name="notary_name" value="<%= policy && policy.policy_details ? policy.policy_details.notary_name : '' %>">
              </div>
              <div class="col-md-4">
                <label for="journal_no" class="form-label">Yevmiye No</label>
                <input type="text" class="form-control" id="journal_no" name="journal_no" value="<%= policy && policy.policy_details ? policy.policy_details.journal_no : '' %>">
              </div>
              <div class="col-md-4">
                <label for="area_sqm" class="form-label">Alan (m²)</label>
                <input type="number" class="form-control" id="area_sqm" name="area_sqm" value="<%= policy && policy.policy_details ? policy.policy_details.area_sqm : '' %>">
              </div>
            </div>
            <div class="row mb-2">
              <div class="col-md-4">
                <label for="building_age" class="form-label">Bina Yaşı</label>
                <input type="text" class="form-control" id="building_age" name="building_age" value="<%= policy && policy.policy_details ? policy.policy_details.building_age : '' %>">
              </div>
              <div class="col-md-4">
                <label for="total_floors" class="form-label">Toplam Kat</label>
                <input type="text" class="form-control" id="total_floors" name="total_floors" value="<%= policy && policy.policy_details ? policy.policy_details.total_floors : '' %>">
              </div>
              <div class="col-md-4">
                <label for="floor_no" class="form-label">Kat No</label>
                <input type="text" class="form-control" id="floor_no" name="floor_no" value="<%= policy && policy.policy_details ? policy.policy_details.floor_no : '' %>">
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary">Kaydet</button>
        <a href="/policies" class="btn btn-secondary">İptal</a>
      </div>
    </form>
  </div>
</div>