<div class="mb-4">
  <div class="row">
    <div class="col-md-8">
      <h2>Müşteriler</h2>
    </div>
    <div class="col-md-4 text-end">
      <a href="/customers/new" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> Yeni Müşteri
      </a>
    </div>
  </div>
</div>

<div class="card mb-4">
  <div class="card-body">
    <form method="get" action="/customers" class="row g-3">
      <div class="col-md-4">
        <input type="text" class="form-control" name="q" placeholder="Ara..." value="<%= query.q || '' %>">
      </div>
      <div class="col-md-4">
        <select class="form-select" name="branch">
          <option value="">Tüm Şubeler</option>
          <option value="Akhisar" <%= query.branch === 'Akhisar' ? 'selected' : '' %>>Akhisar</option>
          <option value="Balıkesir" <%= query.branch === 'Balıkesir' ? 'selected' : '' %>>Balıkesir</option>
          <option value="Ada Şube" <%= query.branch === 'Ada Şube' ? 'selected' : '' %>>Ada Şube</option>
          <option value="İlke Şube" <%= query.branch === 'İlke Şube' ? 'selected' : '' %>>İlke Şube</option>
        </select>
      </div>
      <div class="col-md-4 d-flex gap-2">
        <button type="submit" class="btn btn-primary flex-grow-1">Filtrele</button>
        <a href="/customers" class="btn btn-outline-secondary">Sıfırla</a>
      </div>
    </form>
  </div>
</div>

<div class="card">
  <div class="card-body">
    <div class="table-responsive">
      <table class="table table-hover">
        <thead>
          <tr>
            <th>#</th>
            <th>Ad Soyad</th>
            <th>Şube</th>
            <th>TC / VKN</th>
            <th>Telefon</th>
            <th>E-posta</th>
            <th>İşlemler</th>
          </tr>
        </thead>
        <tbody>
          <% if (customers.length === 0) { %>
            <tr>
              <td colspan="7" class="text-center text-muted py-4">Müşteri bulunamadı</td>
            </tr>
          <% } %>
          <% customers.forEach(customer => { %>
            <tr>
              <td><%= customer.id %></td>
              <td><%= customer.name %></td>
              <td><span class="badge bg-secondary"><%= customer.branch %></span></td>
              <td><%= customer.id_no || '-' %></td>
              <td><%= customer.phone || '-' %></td>
              <td><%= customer.email || '-' %></td>
              <td>
                <div class="d-flex gap-1">
                  <a href="/customers/<%= customer.id %>" class="btn btn-sm btn-outline-info">Görüntüle</a>
                  <a href="/customers/<%= customer.id %>/edit" class="btn btn-sm btn-outline-primary">Düzenle</a>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>
