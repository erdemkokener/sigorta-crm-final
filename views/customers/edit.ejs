<div class="card mb-4">
  <div class="card-header">
    <% if (customer) { %>
      Müşteri Düzenle
    <% } else { %>
      Yeni Müşteri
    <% } %>
  </div>
  <div class="card-body">
    <form method="post" action="<%= customer ? `/customers/${customer.id}/edit` : `/customers/new` %>">
      <div class="row mb-3">
        <div class="col-md-6">
          <label for="name" class="form-label">Ad Soyad *</label>
          <input type="text" class="form-control" id="name" name="name" value="<%= customer ? customer.name : '' %>" required>
        </div>
        <div class="col-md-6">
          <label for="phone" class="form-label">Telefon</label>
          <input type="text" class="form-control" id="phone" name="phone" value="<%= customer ? customer.phone : '' %>">
        </div>
      </div>
      <div class="row mb-3">
        <div class="col-md-4">
          <label for="id_no" class="form-label">TC / VKN</label>
          <input type="text" class="form-control" id="id_no" name="id_no" value="<%= customer ? customer.id_no : '' %>">
        </div>
        <div class="col-md-4">
          <label for="branch" class="form-label">Şube</label>
          <select class="form-select" id="branch" name="branch">
            <option value="Akhisar" <%= customer && customer.branch === 'Akhisar' ? 'selected' : '' %>>Akhisar</option>
            <option value="Balıkesir" <%= customer && customer.branch === 'Balıkesir' ? 'selected' : '' %>>Balıkesir</option>
            <option value="Ada Şube" <%= customer && customer.branch === 'Ada Şube' ? 'selected' : '' %>>Ada Şube</option>
            <option value="İlke Şube" <%= customer && customer.branch === 'İlke Şube' ? 'selected' : '' %>>İlke Şube</option>
          </select>
        </div>
        <div class="col-md-4">
          <label for="email" class="form-label">E-posta</label>
          <input type="email" class="form-control" id="email" name="email" value="<%= customer ? customer.email : '' %>">
        </div>
      </div>
      <div class="row mb-3">
        <div class="col-md-4">
          <label for="profession" class="form-label">Meslek</label>
          <input type="text" class="form-control" id="profession" name="profession" value="<%= customer ? customer.profession : '' %>">
        </div>
        <div class="col-md-4">
          <label for="birth_date" class="form-label">Doğum Tarihi</label>
          <input type="date" class="form-control" id="birth_date" name="birth_date" value="<%= customer ? customer.birth_date : '' %>">
        </div>
        <div class="col-md-4">
          <label for="salesperson_id" class="form-label">Satışçı</label>
          <select class="form-select" id="salesperson_id" name="salesperson_id">
            <option value="">Seçiniz...</option>
            <% salespersons.forEach(salesperson => { %>
              <option value="<%= salesperson.id %>" <%= customer && customer.salesperson_id == salesperson.id ? 'selected' : '' %>>
                <%= salesperson.name %>
              </option>
            <% }) %>
          </select>
        </div>
      </div>
      <div class="mb-3">
        <label for="note" class="form-label">Müşteri Notu</label>
        <textarea class="form-control" id="note" name="note" rows="3"><%= customer ? customer.note : '' %></textarea>
      </div>
      <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary">Kaydet</button>
        <a href="/customers" class="btn btn-secondary">İptal</a>
      </div>
    </form>
  </div>
</div>