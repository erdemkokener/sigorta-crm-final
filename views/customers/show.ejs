<div class="row mb-4">
  <div class="col-md-8">
    <h1 class="h3"><i class="bi bi-person-circle"></i> Müşteri Detayı: <%= customer.name %></h1>
  </div>
  <div class="col-md-4 text-end">
    <a href="/customers/<%= customer.id %>/edit" class="btn btn-warning"><i class="bi bi-pencil"></i> Düzenle</a>
    <a href="/customers" class="btn btn-secondary"><i class="bi bi-arrow-left"></i> Listeye Dön</a>
  </div>
</div>

<div class="row mb-4">
  <!-- Müşteri Bilgi Kartı -->
  <div class="col-md-4">
    <div class="card shadow-sm mb-4">
      <div class="card-header bg-light">
        <h5 class="card-title mb-0">İletişim Bilgileri</h5>
      </div>
      <div class="card-body">
        <p><strong>Telefon:</strong> <%= customer.phone || '-' %></p>
        <p><strong>E-posta:</strong> <%= customer.email || '-' %></p>
        <p><strong>Meslek:</strong> <%= customer.profession || '-' %></p>
        <p><strong>TC/Vergi No:</strong> <%= customer.id_no || '-' %></p>
        <p><strong>Doğum Tarihi:</strong> <%= customer.birth_date || '-' %></p>
        <p><strong>Satışçı / Aracı:</strong> <%= typeof salespersonName !== 'undefined' ? salespersonName : '-' %></p>
        <% if (customer.note) { %>
          <hr>
          <p><strong>Not:</strong><br><span class="text-muted"><%= customer.note %></span></p>
        <% } %>
      </div>
    </div>

    <!-- Araç Listesi Kartı -->
    <div class="card shadow-sm">
      <div class="card-header bg-light">
        <h5 class="card-title mb-0">Kayıtlı Araçlar</h5>
      </div>
      <div class="card-body">
        <% 
           const uniquePlates = new Set();
           if (policies && policies.length > 0) {
             policies.forEach(p => {
               if (p.policy_details && p.policy_details.plate) {
                 uniquePlates.add(p.policy_details.plate.trim().toUpperCase());
               }
             });
           }
           const totalVehicles = uniquePlates.size;
        %>
        <div class="text-center py-3">
          <h3 class="display-6 fw-bold mb-3"><%= totalVehicles %></h3>
          <p class="text-muted">Toplam Kayıtlı Araç</p>
          <% if (totalVehicles > 0) { %>
            <a href="/customers/<%= customer.id %>/vehicles/export.xlsx" class="btn btn-success w-100">
              <i class="bi bi-file-earmark-excel"></i> Excel Olarak İndir
            </a>
          <% } else { %>
            <button class="btn btn-secondary w-100" disabled>Kayıtlı Araç Yok</button>
          <% } %>
        </div>
      </div>
    </div>
  </div>

  <!-- Özet İstatistikler -->
  <div class="col-md-8">
    <div class="row g-3">
      <div class="col-md-4">
        <div class="card bg-primary text-white h-100 cursor-pointer" onclick="filterPolicies('status', 'all')" style="cursor: pointer;">
          <div class="card-body text-center">
            <h6 class="card-title">Toplam Poliçe</h6>
            <div class="display-6 fw-bold"><%= stats.totalPolicies %></div>
          </div>
        </div>
      </div>
      <div class="col-md-4">
        <div class="card bg-success text-white h-100 cursor-pointer" onclick="filterPolicies('status', 'active')" style="cursor: pointer;">
          <div class="card-body text-center">
            <h6 class="card-title">Aktif Poliçeler</h6>
            <div class="display-6 fw-bold"><%= stats.activePolicies %></div>
          </div>
        </div>
      </div>
      <div class="col-md-4">
        <div class="card bg-danger text-white h-100 cursor-pointer" onclick="filterPolicies('status', 'expired')" style="cursor: pointer;">
          <div class="card-body text-center">
            <h6 class="card-title">Süresi Bitenler</h6>
            <div class="display-6 fw-bold"><%= stats.expiredPolicies %></div>
          </div>
        </div>
      </div>
      
      <!-- Poliçe Dağılımı -->
      <div class="col-12">
        <div class="card shadow-sm">
          <div class="card-header bg-light">
            <h6 class="card-title mb-0">Poliçe Dağılımı</h6>
          </div>
          <div class="card-body">
            <% if (Object.keys(policyDistribution).length === 0) { %>
              <div class="text-muted text-center py-2">Henüz poliçe yok.</div>
            <% } else { %>
              <div class="row">
                <% Object.entries(policyDistribution).forEach(([type, count]) => { %>
                  <div class="col-md-4 col-sm-6 mb-2">
                    <div class="d-flex justify-content-between align-items-center border p-2 rounded cursor-pointer hover-bg-light" onclick="filterPolicies('type', '<%= type %>')" style="cursor: pointer;">
                      <span class="fw-bold"><%= type %></span>
                      <span class="badge bg-secondary rounded-pill"><%= count %></span>
                    </div>
                  </div>
                <% }) %>
              </div>
            <% } %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
      <div class="col-md-4">
        <div class="card bg-dark text-white h-100">
          <div class="card-body text-center">
            <h6 class="card-title">Toplam Prim</h6>
            <h2 class="display-6"><%= stats.totalPremium.toFixed ? stats.totalPremium.toFixed(2) : stats.totalPremium %></h2>
          </div>
        </div>
      </div>
      <div class="col-md-4">
        <div class="card bg-info text-white h-100">
          <div class="card-body text-center">
            <h6 class="card-title">Manuel Borç</h6>
            <h2 class="display-6"><%= stats.manualDebt.toFixed ? stats.manualDebt.toFixed(2) : stats.manualDebt %></h2>
          </div>
        </div>
      </div>
      <div class="col-md-4">
        <div class="card bg-warning text-dark h-100">
          <div class="card-body text-center position-relative">
            <h6 class="card-title">Kalan Borç</h6>
            <h2 class="display-6"><%= stats.totalRemaining.toFixed ? stats.totalRemaining.toFixed(2) : stats.totalRemaining %></h2>
            <div class="mt-2">
              <div class="btn-group w-100">
                <a href="/customers/<%= customer.id %>/debts/export-excel" class="btn btn-sm btn-outline-dark">
                  <i class="bi bi-file-earmark-excel"></i> Excel
                </a>
                <a href="/customers/<%= customer.id %>/debts/export-pdf" class="btn btn-sm btn-outline-dark">
                  <i class="bi bi-file-earmark-pdf"></i> PDF
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="card shadow-sm">
  <div class="card-header bg-light d-flex justify-content-between align-items-center">
    <h5 class="mb-0">Poliçe Geçmişi</h5>
    <div class="btn-group">
      <a href="/customers/<%= customer.id %>/invoice" class="btn btn-sm btn-outline-secondary"><i class="bi bi-printer"></i> Fatura Yazdır</a>
      <a href="/policies/new?customer_id=<%= customer.id %>" class="btn btn-sm btn-primary"><i class="bi bi-plus-lg"></i> Yeni Poliçe Ekle</a>
    </div>
  </div>
  <div class="card-body p-0">
    <div class="p-3 border-bottom">
      <div class="row g-2 align-items-end">
        <div class="col-md-4">
          <label class="form-label">Arama</label>
          <div class="input-group">
            <input type="text" class="form-control" id="policyFilterQuery" placeholder="Plaka / Poliçe No">
            <button class="btn btn-primary" type="button" id="policyFilterBtn"><i class="bi bi-search"></i> Ara</button>
          </div>
        </div>
        <div class="col-md-3">
          <label class="form-label">Başlangıç Tarihi (En erken)</label>
          <input type="date" class="form-control" id="policyStartFrom">
        </div>
        <div class="col-md-3">
          <label class="form-label">Bitiş Tarihi (En geç)</label>
          <input type="date" class="form-control" id="policyEndTo">
        </div>
        <div class="col-md-2">
          <button type="button" class="btn btn-outline-secondary w-100" id="policyFilterClear">Temizle</button>
        </div>
      </div>
    </div>
    <div class="table-responsive">
      <table class="table table-sm table-hover mb-0" style="font-size: 0.75rem;">
        <thead class="table-light">
          <tr>
            <th>Poliçe No</th>
            <th>Şirket</th>
            <th>Tür</th>
            <th>Başlangıç</th>
            <th>Bitiş</th>
            <th>Kalan Gün</th>
            <th class="text-end">Kalan Borç</th>
            <th>Durum</th>
            <th class="text-end">İşlem</th>
          </tr>
        </thead>
        <tbody>
          <% if (policies.length === 0) { %>
            <tr><td colspan="9" class="text-center py-4">Kayıtlı poliçe bulunamadı.</td></tr>
          <% } else { %>
            <% policies.forEach(p => { %>
              <tr data-plate="<%= (p.policy_details && p.policy_details.plate) || '' %>" 
                  data-policy-number="<%= p.policy_number %>" 
                  data-start="<%= p.start_date %>" 
                  data-end="<%= p.end_date %>"
                  data-status="<%= (p.status === 'active' || p.status === 'Aktif') ? 'active' : ((p.status === 'cancelled' || p.status === 'İptal') ? 'cancelled' : 'other') %>"
                  data-is-expired="<%= p.days_remaining < 0 ? 'true' : 'false' %>"
                  data-type="<%= p.policy_type %>">
                <td><a href="/policies/<%= p.id %>" class="text-decoration-none fw-bold"><%= p.policy_number %></a></td>
                <td><%= p.insurer %></td>
                <td><span class="badge bg-secondary"><%= p.policy_type %></span></td>
                <td><%= p.start_date %></td>
                <td><%= p.end_date %></td>
                <td>
                  <% if (p.days_remaining < 0) { %>
                    <span class="text-danger">Süresi Doldu</span>
                  <% } else if (p.days_remaining <= 30) { %>
                    <span class="text-warning fw-bold"><%= p.days_remaining %> gün</span>
                  <% } else { %>
                    <span class="text-success"><%= p.days_remaining %> gün</span>
                  <% } %>
                </td>
                <td class="text-end">
                  <% if (p.premium_remaining > 0) { %>
                    <span class="text-danger fw-bold"><%= p.premium_remaining.toFixed(2) %> TL</span>
                  <% } else { %>
                    <span class="text-muted"><i class="bi bi-check-all"></i> Ödendi</span>
                  <% } %>
                </td>
                <td>
                  <% if (p.status === 'active' || p.status === 'Aktif') { %>
                    <span class="badge bg-success">Aktif</span>
                  <% } else if (p.status === 'cancelled' || p.status === 'İptal') { %>
                    <span class="badge bg-danger">İptal</span>
                  <% } else { %>
                    <span class="badge bg-secondary"><%= p.status %></span>
                  <% } %>
                </td>
                <td class="text-end">
                  <% if (p.premium_remaining > 0) { %>
                    <a href="/customers/<%= customer.id %>/invoice?policy_id=<%= p.id %>" class="btn btn-sm btn-outline-success me-1" title="Tahsil Et"><i class="bi bi-cash"></i></a>
                  <% } %>
                  <a href="/policies/<%= p.id %>" class="btn btn-sm btn-outline-primary" title="Detay"><i class="bi bi-eye"></i></a>
                  <a href="/policies/renew/<%= p.id %>" class="btn btn-sm btn-outline-warning" title="Yenile"><i class="bi bi-arrow-repeat"></i></a>
                </td>
              </tr>
            <% }) %>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<div class="card shadow-sm mt-4">
  <div class="card-header bg-light d-flex justify-content-between align-items-center">
    <h5 class="mb-0">Tahsilat Geçmişi</h5>
  </div>
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-sm mb-0">
        <thead class="table-light">
          <tr>
            <th>Tarih</th>
            <th class="text-end">Tutar</th>
            <th>Açıklama</th>
            <% if (user && user.isAdmin) { %>
              <th class="text-end">İşlem</th>
            <% } %>
          </tr>
        </thead>
        <tbody>
          <% if (!payments || payments.length === 0) { %>
            <tr>
              <td colspan="<%= (user && user.isAdmin) ? 4 : 3 %>" class="text-center py-3 text-muted">Kayıtlı tahsilat bulunamadı.</td>
            </tr>
          <% } else { %>
            <% payments.forEach(function(p) { %>
              <tr>
                <td><%= p.date || '-' %></td>
                <td class="text-end"><%= p.amount && p.amount.toFixed ? p.amount.toFixed(2) : p.amount %></td>
                <td><%= p.note || '-' %></td>
                <% if (user && user.isAdmin) { %>
                  <td class="text-end">
                    <a href="/customers/<%= customer.id %>/invoice?print=true&payment_id=<%= p.id %>" target="_blank" class="btn btn-sm btn-outline-primary" title="Yazdır"><i class="bi bi-printer"></i></a>
                    <form action="/payments/<%= p.id %>/delete" method="post" class="d-inline" onsubmit="return confirm('Bu tahsilat silinecek. Emin misiniz?');">
                      <input type="hidden" name="customer_id" value="<%= customer.id %>">
                      <button type="submit" class="btn btn-sm btn-outline-danger" title="Sil"><i class="bi bi-trash"></i></button>
                    </form>
                  </td>
                <% } %>
              </tr>
            <% }) %>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>
<script>
  // Global filter state
  let currentFilter = {
    status: 'all', // all, active, expired
    type: 'all' // all, or specific type
  };

  const qInput = document.getElementById('policyFilterQuery');
  const searchBtn = document.getElementById('policyFilterBtn');
  const startFromInput = document.getElementById('policyStartFrom');
  const endToInput = document.getElementById('policyEndTo');
  const clearBtn = document.getElementById('policyFilterClear');
  const tableBody = document.querySelector('.card-body .table-responsive tbody');
  
  function filterByPlate(plate) {
    if (qInput) {
      qInput.value = plate;
      applyPolicyFilter();
    }
  }

  function filterPolicies(criteria, value) {
    if (criteria === 'status') {
      currentFilter.status = value;
      currentFilter.type = 'all'; 
    } else if (criteria === 'type') {
      currentFilter.type = value;
      currentFilter.status = 'all';
    }
    applyPolicyFilter();
  }

  function applyPolicyFilter() {
    const q = (qInput && qInput.value || '').trim().toLowerCase();
    const startFrom = startFromInput && startFromInput.value || '';
    const endTo = endToInput && endToInput.value || '';
    
    if (!tableBody) return;
    
    const rows = tableBody.querySelectorAll('tr[data-policy-number]');
    rows.forEach(function(row) {
      const plate = (row.dataset.plate || '').toLowerCase();
      const pn = (row.dataset.policyNumber || '').toLowerCase();
      const s = row.dataset.start || '';
      const e = row.dataset.end || '';
      const status = row.dataset.status || '';
      const isExpired = row.dataset.isExpired === 'true';
      const type = row.dataset.type || '';

      // Text and Date Filter
      let matchesTextDate = true;
      if (q) matchesTextDate = plate.includes(q) || pn.includes(q);
      if (matchesTextDate && startFrom) matchesTextDate = !s || s >= startFrom;
      if (matchesTextDate && endTo) matchesTextDate = !e || e <= endTo;

      // Status Filter
      let matchesStatus = true;
      if (currentFilter.status === 'active') {
        matchesStatus = !isExpired && status !== 'cancelled';
      } else if (currentFilter.status === 'expired') {
        matchesStatus = isExpired;
      }
      
      // Type Filter
      let matchesType = true;
      if (currentFilter.type !== 'all') {
        matchesType = type === currentFilter.type;
      }

      if (matchesTextDate && matchesStatus && matchesType) {
        row.style.display = '';
      } else {
        row.style.display = 'none';
      }
    });
  }

  if (qInput) qInput.addEventListener('input', applyPolicyFilter);
  if (searchBtn) searchBtn.addEventListener('click', applyPolicyFilter);
  if (startFromInput) startFromInput.addEventListener('change', applyPolicyFilter);
  if (endToInput) endToInput.addEventListener('change', applyPolicyFilter);
  if (clearBtn) clearBtn.addEventListener('click', function() {
    if (qInput) qInput.value = '';
    if (startFromInput) startFromInput.value = '';
    if (endToInput) endToInput.value = '';
    currentFilter.status = 'all';
    currentFilter.type = 'all';
    applyPolicyFilter();
  });
</script>
