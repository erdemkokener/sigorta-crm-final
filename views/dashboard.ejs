<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
  <h1 class="h2">Panel</h1>
</div>

<div class="row g-3 mb-4">
  <!-- Toplam/Aktif Poliçe -->
  <div class="col-md-6">
    <div class="card h-100 shadow-sm">
      <div class="card-body d-flex justify-content-between align-items-center">
        <div>
          <h6 class="text-muted mb-2">Poliçeler</h6>
          <div class="d-flex align-items-baseline">
            <h2 class="mb-0 me-2"><%= stats.activePolicyCount %></h2>
            <span class="text-success small">Aktif</span>
            <span class="text-muted mx-2">/</span>
            <span class="text-muted"><%= stats.totalPolicyCount %> Toplam</span>
          </div>
        </div>
        <div class="text-end">
            <div class="icon-circle bg-primary text-white p-3 rounded-circle mb-2">
              <i class="bi bi-file-earmark-text fs-4"></i>
            </div>
            <button class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#policyChartModal">
                <i class="bi bi-pie-chart"></i> Dağılım
            </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Toplam/Aktif Müşteri -->
  <div class="col-md-6">
    <div class="card h-100 shadow-sm">
      <div class="card-body d-flex justify-content-between align-items-center">
        <div>
          <h6 class="text-muted mb-2">Müşteriler</h6>
          <div class="d-flex align-items-baseline">
            <h2 class="mb-0 me-2"><%= stats.activeCustomerCount %></h2>
            <span class="text-success small">Aktif</span>
            <span class="text-muted mx-2">/</span>
            <span class="text-muted"><%= stats.totalCustomerCount %> Toplam</span>
          </div>
        </div>
        <div class="icon-circle bg-success text-white p-3 rounded-circle">
          <i class="bi bi-people fs-4"></i>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Şube İstatistikleri -->
<div class="row g-3 mb-4">
  <div class="col-md-6">
    <div class="card h-100 shadow-sm border-start border-primary border-4">
      <div class="card-body">
        <h6 class="text-primary fw-bold mb-3"><i class="bi bi-geo-alt"></i> Akhisar Şubesi</h6>
        <div class="row text-center">
          <div class="col-6 border-end">
            <h4 class="mb-0"><%= stats.branchStats.Akhisar.policies %></h4>
            <small class="text-muted">Poliçe</small>
          </div>
          <div class="col-6">
            <h4 class="mb-0"><%= stats.branchStats.Akhisar.customers %></h4>
            <small class="text-muted">Müşteri</small>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="col-md-6">
    <div class="card h-100 shadow-sm border-start border-info border-4">
      <div class="card-body">
        <h6 class="text-info fw-bold mb-3"><i class="bi bi-geo-alt-fill"></i> Balıkesir İrtibat Ofisi</h6>
        <div class="row text-center">
          <div class="col-6 border-end">
            <h4 class="mb-0"><%= stats.branchStats.Balıkesir.policies %></h4>
            <small class="text-muted">Poliçe</small>
          </div>
          <div class="col-6">
            <h4 class="mb-0"><%= stats.branchStats.Balıkesir.customers %></h4>
            <small class="text-muted">Müşteri</small>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Policy Type Chart Modal -->
<div class="modal fade" id="policyChartModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Poliçe Dağılımı</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        
        <!-- Controls -->
        <div class="card bg-light mb-3">
            <div class="card-body py-2">
                <div class="row align-items-center g-2">
                    <div class="col-auto">
                        <label class="fw-bold small">Görünüm:</label>
                    </div>
                    <div class="col-auto">
                        <div class="btn-group btn-group-sm" role="group">
                            <input type="radio" class="btn-check" name="chartFilterType" id="filterAll" value="all" checked>
                            <label class="btn btn-outline-primary" for="filterAll">Genel (Aktif)</label>

                            <input type="radio" class="btn-check" name="chartFilterType" id="filterYearly" value="yearly">
                            <label class="btn btn-outline-primary" for="filterYearly">Yıllık</label>

                            <input type="radio" class="btn-check" name="chartFilterType" id="filterMonthly" value="monthly">
                            <label class="btn btn-outline-primary" for="filterMonthly">Aylık</label>
                        </div>
                    </div>

                    <!-- Year Select -->
                    <div class="col-auto filter-control" id="yearControl" style="display:none;">
                        <select class="form-select form-select-sm" id="chartYear">
                            <% 
                            const currentYear = new Date().getFullYear();
                            for(let y = currentYear + 1; y >= currentYear - 5; y--) { 
                            %>
                                <option value="<%= y %>" <%= y === currentYear ? 'selected' : '' %>><%= y %></option>
                            <% } %>
                        </select>
                    </div>

                    <!-- Month Select -->
                    <div class="col-auto filter-control" id="monthControl" style="display:none;">
                        <select class="form-select form-select-sm" id="chartMonth">
                            <option value="1">Ocak</option>
                            <option value="2">Şubat</option>
                            <option value="3">Mart</option>
                            <option value="4">Nisan</option>
                            <option value="5">Mayıs</option>
                            <option value="6">Haziran</option>
                            <option value="7">Temmuz</option>
                            <option value="8">Ağustos</option>
                            <option value="9">Eylül</option>
                            <option value="10">Ekim</option>
                            <option value="11">Kasım</option>
                            <option value="12">Aralık</option>
                        </select>
                    </div>

                    <div class="col-auto filter-control" id="updateBtnControl" style="display:none;">
                        <button type="button" class="btn btn-sm btn-primary" id="updateChartBtn">
                            <i class="bi bi-arrow-repeat"></i> Güncelle
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <div style="min-height: 300px;">
            <canvas id="policyTypeChart"></canvas>
        </div>
      </div>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
  document.addEventListener('DOMContentLoaded', function() {
    const ctx = document.getElementById('policyTypeChart');
    if (ctx) {
      // Initial Data (All Active)
      const initialData = <%- JSON.stringify(stats.policyTypes) %>;
      let chartInstance = null;

      // Current Date Defaults
      const today = new Date();
      const currentMonth = today.getMonth() + 1;
      document.getElementById('chartMonth').value = currentMonth;

      function renderChart(dataSet) {
        if (chartInstance) {
          chartInstance.destroy();
        }

        const labels = Object.keys(dataSet);
        const data = Object.values(dataSet);
        const total = data.reduce((a, b) => a + b, 0);

        if (total === 0) {
            // Optional: Show "No Data" message?
            // For now, empty chart is fine, maybe title update
        }

        chartInstance = new Chart(ctx, {
          type: 'doughnut',
          data: {
            labels: labels,
            datasets: [{
              label: 'Poliçe Sayısı',
              data: data,
              backgroundColor: [
                '#0d6efd', '#198754', '#ffc107', '#dc3545',
                '#6610f2', '#fd7e14', '#20c997', '#6c757d'
              ],
              hoverOffset: 4
            }]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
              legend: { position: 'bottom' },
              tooltip: {
                callbacks: {
                  label: function(context) {
                    let label = context.label || '';
                    let value = context.raw || 0;
                    if (label) {
                      label += ': ';
                    }
                    let percentage = total > 0 ? Math.round((value / total) * 100) : 0;
                    label += value + ' (' + percentage + '%)';
                    return label;
                  }
                }
              }
            }
          }
        });
      }

      // Initial Render
      renderChart(initialData);

      // UI Logic
      const radios = document.querySelectorAll('input[name="chartFilterType"]');
      const yearControl = document.getElementById('yearControl');
      const monthControl = document.getElementById('monthControl');
      const updateBtnControl = document.getElementById('updateBtnControl');
      const updateBtn = document.getElementById('updateChartBtn');

      function toggleControls() {
        const type = document.querySelector('input[name="chartFilterType"]:checked').value;
        if (type === 'all') {
            yearControl.style.display = 'none';
            monthControl.style.display = 'none';
            updateBtnControl.style.display = 'none';
            // Reset to All Data
            renderChart(initialData);
        } else if (type === 'yearly') {
            yearControl.style.display = 'block';
            monthControl.style.display = 'none';
            updateBtnControl.style.display = 'block';
        } else if (type === 'monthly') {
            yearControl.style.display = 'block';
            monthControl.style.display = 'block';
            updateBtnControl.style.display = 'block';
        }
      }

      radios.forEach(r => r.addEventListener('change', toggleControls));

      // Fetch Logic
      async function fetchAndUpdate() {
        const type = document.querySelector('input[name="chartFilterType"]:checked').value;
        const year = document.getElementById('chartYear').value;
        const month = document.getElementById('chartMonth').value;

        let url = `/api/stats/policy-distribution?year=${year}`;
        if (type === 'monthly') {
            url += `&month=${month}`;
        }

        try {
            updateBtn.disabled = true;
            updateBtn.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>';
            
            const res = await fetch(url);
            if (!res.ok) throw new Error('Veri alınamadı');
            const data = await res.json();
            renderChart(data);

        } catch (err) {
            alert('Hata: ' + err.message);
        } finally {
            updateBtn.disabled = false;
            updateBtn.innerHTML = '<i class="bi bi-arrow-repeat"></i> Güncelle';
        }
      }

      updateBtn.addEventListener('click', fetchAndUpdate);

      // Trigger update automatically when switching to Year/Month if values are present?
      // Better to wait for user to click Update or just default to current selection.
      // Let's keep manual update button to be explicit.
    }
  });
</script>

<div class="row g-3 mb-4">
  <!-- Bugün Bitenler -->
  <div class="col-md-4">
    <div class="card h-100 border-primary">
      <div class="card-header bg-primary text-white">
        <h5 class="card-title mb-0"><i class="bi bi-calendar-check"></i> Bugün Biten Poliçeler</h5>
      </div>
      <div class="card-body">
        <% if (policiesEndingToday.length === 0) { %>
          <p class="text-muted mb-0">Bugün biten poliçe yok.</p>
        <% } else { %>
          <ul class="list-group list-group-flush">
            <% policiesEndingToday.forEach(p => { %>
              <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                <div>
                  <a href="/policies/<%= p.id %>" class="fw-bold text-decoration-none"><%= p.policy_number %></a>
                  <div class="small text-muted"><%= p.customer_name %></div>
                </div>
                <span class="badge bg-danger">Bitiyor</span>
              </li>
            <% }) %>
          </ul>
        <% } %>
      </div>
      <div class="card-footer bg-transparent border-top-0">
        <a href="/policies?filter=today" class="btn btn-sm btn-outline-primary w-100">Tümünü Gör</a>
      </div>
    </div>
  </div>

  <!-- Bu Hafta Bitenler -->
  <div class="col-md-4">
    <div class="card h-100 border-warning">
      <div class="card-header bg-warning text-dark">
        <h5 class="card-title mb-0"><i class="bi bi-calendar-week"></i> Bu Hafta Bitenler</h5>
      </div>
      <div class="card-body">
        <% if (policiesEndingThisWeek.length === 0) { %>
          <p class="text-muted mb-0">Bu hafta biten poliçe yok.</p>
        <% } else { %>
          <div class="display-6 text-center my-3"><%= policiesEndingThisWeek.length %></div>
          <p class="text-center text-muted">adet poliçe bitiyor</p>
        <% } %>
      </div>
      <div class="card-footer bg-transparent border-top-0">
        <a href="/policies?filter=week" class="btn btn-sm btn-outline-warning w-100">Listele</a>
      </div>
    </div>
  </div>

  <!-- Bugün Tahsil Edilmesi Planlananlar (Poliçe Başlangıcı Bugün Olanlar) -->
  <div class="col-md-4">
    <div class="card h-100 border-success">
      <div class="card-header bg-success text-white">
        <h5 class="card-title mb-0"><i class="bi bi-cash-coin"></i> Bugün Tahsilat Planı</h5>
      </div>
      <div class="card-body">
        <p class="small text-muted">Bugün başlayan poliçeler (Tahsilat bekleniyor)</p>
        <% if (policiesStartingToday.length === 0) { %>
          <p class="text-muted mb-0">Bugün başlayan poliçe yok.</p>
        <% } else { %>
          <ul class="list-group list-group-flush">
            <% policiesStartingToday.forEach(p => { %>
              <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                <div>
                  <a href="/policies/<%= p.id %>" class="fw-bold text-decoration-none"><%= p.policy_number %></a>
                  <div class="small text-muted"><%= p.customer_name %></div>
                </div>
                <span class="badge bg-success"><%= p.premium %> TL</span>
              </li>
            <% }) %>
          </ul>
        <% } %>
      </div>
    </div>
  </div>
</div>

<div class="row">
  <div class="col-12">
    <div class="card shadow-sm">
      <div class="card-header bg-light">
        <h5 class="mb-0">Hatırlatmalar</h5>
      </div>
      <div class="card-body">
         <% if (reminders.length === 0) { %>
            <p class="text-muted">Yaklaşan özel hatırlatma yok.</p>
         <% } else { %>
            <div class="table-responsive">
              <table class="table table-hover">
                <thead>
                  <tr>
                    <th>Tarih</th>
                    <th>Poliçe</th>
                    <th>Müşteri</th>
                    <th>Not</th>
                    <th>İşlem</th>
                  </tr>
                </thead>
                <tbody>
                  <% reminders.forEach(r => { %>
                    <tr>
                      <td>
                        <% if (r.isToday) { %>
                          <span class="badge bg-danger">Bugün</span>
                        <% } else { %>
                          <%= r.custom_reminder_date %>
                        <% } %>
                      </td>
                      <td><a href="/policies/<%= r.id %>"><%= r.policy_number %></a></td>
                      <td><%= r.customer_name %></td>
                      <td><%= r.custom_reminder_note %></td>
                      <td><a href="/policies/<%= r.id %>" class="btn btn-sm btn-outline-primary">Git</a></td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
         <% } %>
      </div>
    </div>
  </div>
</div>
